# Canonical public URL. Use the real HTTPS URL in production; localhost is for development only.
SITE_URL=http://localhost:3000
# Legacy fallback. Keep in sync with SITE_URL if an existing deployment still relies on it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. In Docker Compose, hostname is `db`.
DATABASE_URL=postgres://payload:change-this-password@localhost:5433/funeral_site

# Generate a unique random secret of at least 32 characters.
# Example generation: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional lead notifications. Leave empty until real credentials and addresses are configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
LEADS_EMAIL_TO=

# Docker Compose PostgreSQL password (used by compose service).
POSTGRES_PASSWORD=change-this-password
