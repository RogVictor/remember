{
  "name": "funeral-services-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "about:seed": "node --import=./scripts/payload-cli-loader.mjs scripts/about/seed.mjs",
    "content:check": "node --import=./scripts/payload-cli-loader.mjs scripts/content-v4/import.mjs --dry-run",
    "content:import": "node --import=./scripts/payload-cli-loader.mjs scripts/content-v4/import.mjs --apply",
    "test:content": "tsx --test tests/content-v4.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:leads": "tsx --test tests/leads.test.mjs",
    "test:chat": "node --test tests/chat.test.mjs",
    "test:about": "node --import=./scripts/payload-cli-loader.mjs --test --test-force-exit tests/about.test.mjs",
    "test:funeral": "node --import=./scripts/payload-cli-loader.mjs --test --test-force-exit tests/funeral.test.mjs",
    "test:telegram": "node --test tests/telegram-proxy.test.mjs",
    "payload:types": "node --experimental-strip-types --import=./scripts/payload-cli-loader.mjs ./node_modules/payload/bin.js --disable-transpile generate:types",
    "payload:importmap": "node --experimental-strip-types --import=./scripts/payload-cli-loader.mjs ./node_modules/payload/bin.js --disable-transpile generate:importmap",
    "payload:migrate:create": "node --experimental-strip-types --import=./scripts/payload-cli-loader.mjs ./node_modules/payload/bin.js --disable-transpile migrate:create",
    "payload:migrate": "node --experimental-strip-types --import=./scripts/payload-cli-loader.mjs ./node_modules/payload/bin.js --disable-transpile migrate",
    "payload:migrate:status": "node --experimental-strip-types --import=./scripts/payload-cli-loader.mjs ./node_modules/payload/bin.js --disable-transpile migrate:status",
    "verify:scaffold": "node scripts/verify-scaffold.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "graphql": "^16.8.1",
    "next": "~16.3.3",
    "nodemailer": "^10.1.7",
    "payload": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.28.0",
    "eslint-config-next": "~16.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "sass": "^1.105.2"
  }
}
